# Paths are relative to backend/, independent of the launch directory.
DATABASE_PATH=data/poi.sqlite3

# JSON array of exact frontend origins, including the port.
CORS_ORIGINS=["http://localhost:5173"]

# OSM collection: south, west, north, east. Bounding rectangle, not city border.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_BBOX=[50.95,71.20,51.30,71.75]
OVERPASS_TIMEOUT_SECONDS=45
OVERPASS_ATTEMPTS=3
OVERPASS_RETRY_DELAY_SECONDS=2
POI_CACHE_PATH=cache/overpass.json
TRANSIT_CACHE_PATH=cache/transit-overpass.json
POI_CACHE_TTL_SECONDS=86400

# Optional: empty key uses grounded template explanations.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=8
